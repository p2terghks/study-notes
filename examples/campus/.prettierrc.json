{
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "htmlWhitespaceSensitivity": "css",
  "overrides": [
    {
      "files": "*.java",
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": "*.xml",
      "options": {
        "xmlWhitespaceSensitivity": "ignore"
      }
    }
  ]
}
